# Copy to .env for local development with `netlify dev`.
# On Netlify, set these under Project configuration > Environment variables.

# Comma-separated emails that can welcome members in, hide profiles and reset passwords.
ADJOIN_ADMIN_EMAILS=admin@adjoin.test

# Example profiles show on previews and local dev only. "on" forces them, "off" hides them.
# ADJOIN_EXAMPLES=off
